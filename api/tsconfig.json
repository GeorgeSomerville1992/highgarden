{
  // Vercel compiles api/*.ts with the nearest tsconfig.json, so this file
  // also sets the options the deployed function is built with.
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "skipLibCheck": true,

    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [".", "../src/feeds/config.ts", "../src/feeds/types.ts"]
}
